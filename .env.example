# Orchestra 环境配置示例
# 复制为 .env 后按需修改：
#   PowerShell: Copy-Item .env.example .env
#   命令行:      copy .env.example .env
# .env 已被 gitignore 忽略，不会上传到 GitHub。

# LLM Provider：mock 或 openai
ORCHESTRA_LLM_PROVIDER=mock

# OpenAI 兼容服务配置
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ORCHESTRA_LLM_MODEL=gpt-4o-mini
ORCHESTRA_FALLBACK_MODEL=

# 存储与工作区路径
ORCHESTRA_DB_PATH=data/orchestra.db
ORCHESTRA_WORKSPACE_ROOT=data/workspaces

# 服务监听地址
ORCHESTRA_HOST=127.0.0.1
ORCHESTRA_PORT=8000

# ===== 第二阶段预留配置（未启用，实施时按包启用） ====

# 包 1：路由与拆解底座
ORCHESTRA_ROUTING_GOLDEN_PATH=data/golden/routing.json
ORCHESTRA_ROUTING_AMBIGUOUS_BAND=0.25,0.35
ORCHESTRA_HR_SCENARIO_THRESHOLD=0.30

# 包 2：真实 RAG / ChromaDB / Embedding
# ORCHESTRA_EMBEDDING_PROVIDER=openai
# ORCHESTRA_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# ORCHESTRA_EMBEDDING_DIM=512
# ORCHESTRA_EMBEDDING_API_KEY=
# ORCHESTRA_CHROMA_PATH=data/chroma
# ORCHESTRA_CHROMA_HOST=127.0.0.1
# ORCHESTRA_CHROMA_PORT=8001
# ORCHESTRA_COLLECTION_PREFIX=orchestra
# ORCHESTRA_KNOWLEDGE_SOURCE_DIR=data/knowledge
# ORCHESTRA_RETRIEVAL_TOP_K=5
# ORCHESTRA_RETRIEVAL_MODE=hybrid
# ORCHESTRA_RERANK_ENABLED=false
# ORCHESTRA_RERANK_MODEL=BAAI/bge-reranker-base

# 包 3：Redis Streams + 自研状态机
# ORCHESTRA_WORKFLOW_DRIVER=sqlite
# ORCHESTRA_REDIS_URL=redis://127.0.0.1:6379/0
# ORCHESTRA_REDIS_STREAM_PREFIX=orchestra
# ORCHESTRA_REDIS_CONSUMER_GROUP=orchestra-workers
# ORCHESTRA_WORKER_CONCURRENCY=4
# ORCHESTRA_RETRY_MAX_ATTEMPTS=3
# ORCHESTRA_RETRY_BASE_DELAY_MS=1000
# ORCHESTRA_RETRY_MAX_DELAY_MS=60000
# ORCHESTRA_RETRY_JITTER_MS=200
