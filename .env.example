# Orchestra 环境配置示例
# 复制为 .env 后按需修改：
#   PowerShell: Copy-Item .env.example .env
#   命令行:      copy .env.example .env
# .env 已被 gitignore 忽略，不会上传到 GitHub。

# LLM Provider：mock 或 openai
ORCHESTRA_LLM_PROVIDER=mock

# OpenAI 兼容服务配置
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ORCHESTRA_LLM_MODEL=gpt-4o-mini
ORCHESTRA_FALLBACK_MODEL=

# 存储与工作区路径
ORCHESTRA_DB_PATH=data/orchestra.db
ORCHESTRA_WORKSPACE_ROOT=data/workspaces

# 服务监听地址
ORCHESTRA_HOST=127.0.0.1
ORCHESTRA_PORT=8000